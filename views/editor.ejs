<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editor</title>
  </head>

  <body>
    <div><%- include("header.ejs") %></div>

    <div class="editor-body">
      <h2><%= post ? "Edit Post" : "Create a Post" %></h2>

      <% const isEditing = post !== null; const formAction = isEditing ?
      "/edit-post/" + post.id + "?_method=PUT" : "/create-post"; %>

      <form action="<%= formAction %>" method="POST" class="post-form">
        <div class="form-group">
          <label for="title"><strong>Title:</strong></label>
          <br />
          <input
            type="text"
            id="title"
            name="title"
            value="<%= post ? post.title : '' %>"
          />
        </div>
        <hr />

        <div class="form-group">
          <label for="content"><strong>Content:</strong></label>
          <br />
          <textarea id="content" name="content">
<%= post ? post.content : '' %></textarea
          >
        </div>
        <br />

        <button class="btn my-btn button-center" type="submit">
          <%= post ? "Save" : "Create Post" %>
        </button>
      </form>
    </div>
  </body>
</html>
